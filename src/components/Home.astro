---
import { ui, route, type Lang } from '../content/ui';
import Icon from './Icon.astro';
import Workspace from './Workspace.astro';
import Contact from './Contact.astro';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
---
<section class="hero">
  <div class="hero-orbit" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy"><p class="eyebrow"><span></span>{t.eyebrow}</p><h1>{t.hero[0]}<br /><em>{t.hero[1]}</em></h1><p class="hero-description">{t.heroText}</p><div class="hero-actions"><a class="button" href="#contact">{t.contact}<Icon name="arrow" class="directional" /></a><a class="text-link" href="#features">{t.explore}<span aria-hidden="true">↙</span></a></div><div class="hero-meta"><span><Icon name="window" />Windows</span><span><span class="status-dot"></span>{t.development}</span><span>{t.arabic}</span></div></div>
    <Workspace lang={lang} />
  </div>
  <div class="container hero-footnote"><span class="section-index" aria-hidden="true">01 / 06</span><span>{t.tagline}</span><a href="#intro" aria-label={t.explore}>↓</a></div>
</section>
<div class="workflow-strip"><div class="container">{t.workflow.map((item, i) => <span><Icon name={['users', 'calendar', 'tooth', 'wallet', 'backup'][i]} />{item}</span>)}</div></div>
<section class="section intro-section" id="intro"><div class="container intro-grid"><div><p class="eyebrow">{t.introLabel}</p><h2 class="preserve-lines">{t.introTitle}</h2></div><p class="intro-copy">{t.introText}</p></div></section>
<section class="section features-section" id="features"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.featuresLabel}</p><h2 class="preserve-lines">{t.featuresTitle}</h2></div><p>{t.featuresText}</p><span class="section-index" aria-hidden="true">02 / 06</span></div><div class="feature-grid">{t.features.map(([icon, title, text], i) => <article class="feature-card"><div class="feature-top"><span class="feature-icon"><Icon name={icon} /></span><span class="feature-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></div><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section clinical-section"><div class="container split-grid"><div class="clinical-art" role="img" aria-label={lang === 'ar' ? 'رسم توضيحي يربط سجل السن بخطة العلاج والجلسات' : 'Illustration connecting a tooth record with treatment plans and sessions'}><div class="art-grid" aria-hidden="true"></div><div class="tooth-orbit" aria-hidden="true"><div class="tooth-center"><Icon name="tooth" /></div></div><div class="art-label art-label-one"><Icon name="file" />{t.toothRecord}</div><div class="art-label art-label-two"><Icon name="layers" />{t.treatment}</div><div class="art-label art-label-three"><Icon name="calendar" />{t.session}</div><div class="art-caption"><span class="status-dot"></span>{t.connected}</div></div><div class="section-copy"><p class="eyebrow">{t.clinicalLabel}</p><h2 class="preserve-lines">{t.clinicalTitle}</h2><p>{t.clinicalText}</p><ul class="check-list">{t.clinicalPoints.map(text => <li><Icon name="check" />{text}</li>)}</ul></div></div></section>
<section class="section finance-section"><div class="container split-grid"><div class="section-copy"><p class="eyebrow">{t.financialLabel}</p><h2 class="preserve-lines">{t.financialTitle}</h2><p>{t.financialText}</p><div class="tag-list">{t.financialTags.map(text => <span>{text}</span>)}</div></div><div class="finance-art"><div class="finance-art-heading"><Icon name="chart" /><span>{t.financialFlow[0]}</span></div>{t.financialFlow.slice(1).map((text, i) => <div class="finance-row"><span class="finance-icon"><Icon name={['wallet', 'box', 'chart'][i]} /></span><strong>{text}</strong><span class="finance-line" aria-hidden="true"></span><Icon name="check" /></div>)}<div class="finance-art-footer"><Icon name="layers" />{t.featuresText}</div></div></div></section>
<section class="section security-section" id="security"><div class="container"><div class="security-heading"><div><p class="eyebrow">{t.securityLabel}</p><h2 class="preserve-lines">{t.securityTitle}</h2></div><div><p>{t.securityText}</p><a class="text-link" href={route(lang, 'privacy')}>{t.securityLink}<Icon name="arrow" class="directional" /></a></div><span class="section-index" aria-hidden="true">03 / 06</span></div><div class="security-grid">{t.securityItems.map(([title, text], i) => <article><span class="security-icon"><Icon name={['lock', 'shield', 'key'][i]} /></span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section drive-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">{t.driveLabel}</p><h2 class="preserve-lines">{t.driveTitle}</h2></div><p>{t.driveText}</p><span class="section-index" aria-hidden="true">04 / 06</span></div><ol class="drive-steps">{t.driveSteps.map(([title, text], i) => <li><span class="step-number">0{i + 1}</span><Icon name={['globe', 'cloud', 'backup'][i]} /><h3>{title}</h3><p>{text}</p></li>)}</ol><p class="drive-note"><Icon name="window" />{t.driveNote}</p></div></section>
<section class="section faq-section" id="faq"><div class="container faq-grid"><div><p class="eyebrow">{t.faqLabel}</p><h2>{t.faqTitle}</h2><span class="section-index" aria-hidden="true">05 / 06</span></div><div class="faq-list">{t.faqs.map(([question, answer]) => <details><summary>{question}<span class="faq-plus" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>
<section class="contact-section" id="contact"><div class="container contact-grid"><div><p class="eyebrow">{t.contactLabel}</p><h2 class="preserve-lines">{t.contactTitle}</h2><p>{t.contactText}</p></div><div><span class="section-index" aria-hidden="true">06 / 06</span><Contact lang={lang} /></div></div></section>
